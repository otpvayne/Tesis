# Copiar a .env.local y completar con valores reales del proyecto en Supabase/Vercel.
# NUNCA commitear .env.local ni ningún archivo con valores reales.
# Estos nombres son la convención propuesta en Fase 0; se confirman en Fase 1 (bootstrap
# técnico) al crear el proyecto real de Supabase.

# Supabase — públicas, seguras para el navegador (protegidas por RLS, no por secreto)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ejemplo-clave-anonima-publica

# Supabase — SOLO servidor. Jamás exponer al cliente ni prefijar con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=ejemplo-clave-service-role-nunca-en-frontend

# Storage
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=documents

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OCR — motor de reconocimiento a usar en /documents/[id]. "custom" (default, se puede
# omitir esta línea) usa el pipeline propio (HOG+kNN desde cero). "tesseract" usa
# Tesseract.js como motor alternativo — excepción aprobada 2026-09-08, ver CLAUDE.md §7.
NEXT_PUBLIC_OCR_ENGINE=custom
