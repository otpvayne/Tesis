# Copiar a .env.e2e (no commitear) y completar con cuentas reales de PRUEBA del
# proyecto Supabase real -- nunca credenciales ni datos reales de Mansor.
# Variables leídas por tests/e2e/*, tests/regression/*, tests/security/*,
# tests/performance/* (Fase 7) y por playwright.config.ts.
#
# Uso (PowerShell), desde la raíz del repo, antes de `npx playwright test`:
#   Get-Content .env.e2e | ForEach-Object {
#     if ($_ -match '^\s*([A-Z_]+)=(.*)$') { Set-Item "env:$($Matches[1])" $Matches[2] }
#   }

# URL base contra la que corren los tests. Por defecto apunta a un servidor
# local (`npm run dev` en otra terminal). Para correr contra el deploy real de
# Vercel, usar esa URL en su lugar.
E2E_BASE_URL=http://localhost:3000

# Cuenta USER de prueba (crear en /register o directo en Supabase Auth).
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# Cuenta ADMIN de prueba (crear como USER y luego `update profiles set role='ADMIN' where id=...`).
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Segunda cuenta USER, distinta de E2E_USER_EMAIL -- solo para el test de
# aislamiento RLS (que un usuario no pueda abrir el documento de otro).
E2E_OTHER_USER_EMAIL=
E2E_OTHER_USER_PASSWORD=

# Id de un documento ya subido, procesado (OCR) y validado por E2E_USER_EMAIL
# -- usado por el test de regresión de la tabla de validación. Se obtiene
# subiendo un documento manualmente una vez y copiando su id de la URL
# /documents/{id}.
E2E_KNOWN_DOCUMENT_ID=
